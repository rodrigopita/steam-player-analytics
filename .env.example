# Copy to .env and fill in. Astro injects every line into the Airflow containers
# on `astro dev start`; edit, then `astro dev restart` for changes to take effect.

# Steam Web API key, free at https://steamcommunity.com/dev/apikey
AIRFLOW_VAR_STEAM_API_KEY=<your-steam-key>

# S3 bucket for the raw zone, one you own. Airflow reads it as a Variable.
AIRFLOW_VAR_RAW_BUCKET=<your-bucket-name>

# Pipeline IAM user. login is the access key id, password the secret.
AIRFLOW_CONN_AWS_DEFAULT={"conn_type": "aws", "login": "<key-id>", "password": "<secret>", "extra": {"region_name": "<bucket-region>"}}

# Warehouse Postgres from docker-compose.override.yml. Local only, bound to
# localhost:5433 on the host; the password must match the override and dbt/profiles.yml.
AIRFLOW_CONN_WAREHOUSE={"conn_type": "postgres", "host": "warehouse", "port": 5432, "login": "warehouse", "password": "steamdw-local", "schema": "steam"}
